# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/ops_hub

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_to_a_random_32_char_string_minimum
JWT_EXPIRES_IN=8h

# ── Deel Admin API ────────────────────────────────────────────────────────────
DEEL_API_KEY=
DEEL_API_BASE_URL=https://api.deel.com

# ── Zendesk ───────────────────────────────────────────────────────────────────
ZENDESK_SUBDOMAIN=deel
ZENDESK_EMAIL=ops@deel.com
ZENDESK_API_TOKEN=
ZENDESK_WEBHOOK_SECRET=

# ── Jira ──────────────────────────────────────────────────────────────────────
JIRA_BASE_URL=https://deel.atlassian.net
JIRA_EMAIL=ops@deel.com
JIRA_API_TOKEN=
JIRA_PROJECT_KEYS=HR,OPS

# ── Slack ─────────────────────────────────────────────────────────────────────
SLACK_BOT_TOKEN=xoxb-
SLACK_SIGNING_SECRET=
SLACK_CHANNEL_IDS=C00000000,C00000001

# ── Google / Gmail ────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GMAIL_LABEL=hr-ops

# ── Snowflake (reporting) ─────────────────────────────────────────────────────
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USERNAME=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_DATABASE=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_SCHEMA=
