{
  "name": "ops-hub-api",
  "version": "1.0.0",
  "description": "Ops Hub API — Node.js/TypeScript backend following DDD + Hexagonal Architecture",
  "main": "dist/infrastructure/http/server.js",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "start": "node dist/infrastructure/http/server.js",
    "start:cluster": "node dist/cluster.js",
    "dev": "ts-node-dev --respawn --transpile-only src/infrastructure/http/server.ts",
    "migrate": "node dist/infrastructure/persistence/migrate.js",
    "seed": "ts-node-dev src/infrastructure/persistence/seed.ts",
    "lint": "eslint 'src/**/*.ts'",
    "test": "jest"
  },
  "dependencies": {
    "@slack/bolt": "^3.19.0",
    "@slack/web-api": "^7.1.0",
    "axios": "^1.6.8",
    "bullmq": "^5.71.1",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "express-rate-limit": "^7.2.0",
    "googleapis": "^137.1.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^3.0.3",
    "node-zendesk": "^6.0.1",
    "pg": "^8.11.5",
    "uuid": "^9.0.1",
    "winston": "^3.13.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/ioredis": "^4.28.10",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.12.7",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.11.5",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^7.7.0",
    "@typescript-eslint/parser": "^7.7.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
}
