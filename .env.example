# ── Required in Production ────────────────────────────────────────────────────
JWT_SECRET=                          # Cryptographically random 256-bit secret for signing JWTs
DATABASE_URL=                        # PostgreSQL connection string (e.g., postgresql://user:pass@host:5432/db)
GOOGLE_CLIENT_ID=                    # Google OAuth 2.0 Client ID
GOOGLE_CLIENT_SECRET=                # Google OAuth 2.0 Client Secret
GOOGLE_OAUTH_PROJECT_ID=             # Platform proxy project ID for login.dp.com
NEXTAUTH_URL=                        # Full app URL (e.g., https://jtk-ops-hub-v2.dp.com)

# ── Optional ──────────────────────────────────────────────────────────────────
BASE_URL=                            # Alias for NEXTAUTH_URL
DB_SSL=true                          # Enable SSL for database connections
DB_SSL_REJECT_UNAUTHORIZED=false     # Set to true for strict SSL verification
NEXT_PUBLIC_API_BASE_URL=/api/v1     # Override API base URL (default: /api/v1)
NODE_ENV=production                  # Runtime environment
