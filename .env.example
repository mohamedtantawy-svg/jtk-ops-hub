# ── Required in Production ────────────────────────────────────────────────────
JWT_SECRET=                          # Cryptographically random 256-bit secret for signing JWTs
DATABASE_URL=                        # PostgreSQL connection string (e.g., postgresql://user:pass@host:5432/db)
GOOGLE_CLIENT_ID=                    # Google OAuth 2.0 Client ID
GOOGLE_CLIENT_SECRET=                # Google OAuth 2.0 Client Secret
GOOGLE_OAUTH_PROJECT_ID=             # Platform proxy project ID for login.dp.com
NEXTAUTH_URL=                        # Full app URL (e.g., https://jtk-ops-hub-v2.dp.com)

# ── Integrations: Deel Admin API ──────────────────────────────────────────────
DEEL_API_KEY=                        # Deel REST v2 API token (from Deel Developer Portal)
DEEL_API_BASE_URL=                   # Override base URL (default: https://api.letsdeel.com/rest/v2)
DEEL_ADMIN_TOKEN=                    # Admin session JWT from admin.deel.network (x-auth-token).
                                     # Required for /admin/* endpoints with full pagination + filtering
                                     # (e.g., offboarding queue). Without it, the queue falls back to a
                                     # single unfiltered page (~50 records). Token expires ~30 days;
                                     # copy from DevTools → Network → any terminations_v3 request.

# ── Integrations: Jira / Atlassian ───────────────────────────────────────────
JIRA_BASE_URL=                       # Jira Cloud URL (e.g., https://letsdeel.atlassian.net)
JIRA_USER_EMAIL=                     # Atlassian account email for API auth
JIRA_API_TOKEN=                      # Atlassian API token (https://id.atlassian.net/manage-profile/security/api-tokens)
JIRA_DEFAULT_PROJECT=                # Default Jira project key for new issues (e.g., HROP)

# ── Integrations: Slack ──────────────────────────────────────────────────────
SLACK_BOT_TOKEN=                     # Slack Bot User OAuth Token (xoxb-...)
SLACK_ESCALATION_CHANNEL=            # Channel ID for #escalations (e.g., C01ABCDEF)
SLACK_HR_OPS_CHANNEL=                # Channel ID for #hr-ops (e.g., C02GHIJKL)

# ── Integrations: Google Calendar ────────────────────────────────────────────
# Separate OAuth client from the Nexus login proxy (login.dp.com) — that one
# only has `openid email profile` scopes; Calendar API needs `calendar.readonly`
# on top.
#
# Create once in GCP Console:
#   1. https://console.cloud.google.com/ → pick/create a project
#   2. APIs & Services → Library → enable "Google Calendar API"
#   3. APIs & Services → OAuth consent screen → Internal (@deel.com only)
#   4. APIs & Services → Credentials → Create Credentials → OAuth Client ID
#      → Application type: Web application
#      → Name: ops-hub-calendar
#      → Authorised redirect URIs:
#           https://jtk.dp.com/api/v1/calendar/oauth/callback
#           http://localhost:3000/api/v1/calendar/oauth/callback   (dev only)
#   5. Copy the Client ID and Client Secret into the env vars below.
GOOGLE_CALENDAR_CLIENT_ID=           # OAuth 2.0 Client ID (NOT the Nexus login proxy one)
GOOGLE_CALENDAR_CLIENT_SECRET=       # OAuth 2.0 Client Secret
GOOGLE_CALENDAR_REDIRECT_URI=        # Full callback URL. Defaults to
                                     #   <NEXTAUTH_URL>/api/v1/calendar/oauth/callback
                                     # so in most cases you can leave it blank.

# 32-byte random string used as the AES-256-GCM key for encrypting refresh
# tokens at rest in the calendar_tokens table. Generate with:
#   openssl rand -base64 32
# Rotating this value invalidates every stored refresh token — users will
# have to reconnect their calendar once.
CALENDAR_TOKEN_ENCRYPTION_KEY=       # AES-256 key (base64 or ≥32 raw bytes)

# ── Optional ──────────────────────────────────────────────────────────────────
BASE_URL=                            # Alias for NEXTAUTH_URL
DB_SSL=true                          # Enable SSL for database connections
DB_SSL_REJECT_UNAUTHORIZED=false     # Set to true for strict SSL verification
NEXT_PUBLIC_API_BASE_URL=/api/v1     # Override API base URL (default: /api/v1)
NODE_ENV=production                  # Runtime environment
